# Konfiguration für FairBon
# Kopieren und anpassen:   cp .env.example .env   &&   chmod 600 .env
#
# Alle Einstellungen werden als Umgebungsvariablen gelesen. Kurze Namen
# (STEALTH_MODE, SITE_PASSWORD, SESSION_SECRET, ADMIN_PASSWORD, ...)
# funktionieren direkt; zusätzlich akzeptiert die App die Form mit Präfix
# SUPERMARKET_<FELDNAME>. Ist beides gesetzt, gewinnt die Präfix-Variante.

# --- Zugriffsschutz & Stealth ------------------------------------------------
# true  = noindex-Header, robots.txt "Disallow: /", noindex-Meta in der Seite.
# false = Seite darf von Suchmaschinen indexiert werden.
STEALTH_MODE=true

# Passwort-Gate für UI und API. Leer lassen = kein Passwortschutz.
# Login im Browser unter /login; API-Clients nutzen Basic Auth (Beliebig:Passwort).
# PRODUKTION: starkes Passwort setzen, z. B. `openssl rand -base64 24`.
SITE_PASSWORD=<REDACTED>

# Zufälliges, stabiles Cookie-Secret. Erzeugen mit:
#   openssl rand -base64 32
# Leer = wird aus SITE_PASSWORD abgeleitet.
SESSION_SECRET=

# --- Admin (Fail-Closed) ------------------------------------------------------
# Starkes Passwort für /admin, Backup/Restore und Moderations-Endpunkte.
# WICHTIG: Ohne gesetztes ADMIN_PASSWORD sind diese Endpunkte DEAKTIVIERT (503).
ADMIN_PASSWORD=

# --- CORS & Proxy -------------------------------------------------------------
# Kommaseparierte erlaubte Origins (Default: * für Entwicklung).
# PRODUKTION: explizite Liste setzen, z. B.
#   SUPERMARKET_CORS_ORIGINS=https://fairbon.example.org,capacitor://localhost
# Mit '*' werden keine Credentials/Cookies erlaubt (bewusste Härtung).
SUPERMARKET_CORS_ORIGINS=*

# Vertrauenswürdiger Reverse Proxy? true = CF-Connecting-IP / X-Forwarded-For
# werden fürs Rate-Limiting ausgewertet (nur hinter Caddy/Nginx setzen!).
TRUST_PROXY=false

# --- Rate-Limiting & Kosten-Deckel (Foto-Scans) -------------------------------
MAX_SCANS_PER_DAY_PER_IP=15
MAX_GLOBAL_SCANS_PER_DAY=500

# --- Upload-Härtung -----------------------------------------------------------
# Harte Obergrenze für Bilder/PDFs (Default: 3 MB).
MAX_UPLOAD_BYTES=3145728

# --- Datenbank & Limits -------------------------------------------------------
# Docker setzt den Pfad auf /app/data/supermarkt.db (siehe docker-compose.yml).
SUPERMARKET_DATABASE_PATH=./data/supermarkt.db
SUPERMARKET_MAX_RESULTS=1000
# Im Container gesetzt; nur für einen anderen statischen Pfad überschreiben:
# SUPERMARKET_FRONTEND_DIR=/app/frontend

# --- Vision-API (Kassenbon-Scanner) ------------------------------------------
# Primärer Anbieter: gemini | mistral | openai_compatible | opencode
VISION_PRIMARY_PROVIDER=
VISION_PRIMARY_API_KEY=
VISION_PRIMARY_MODEL=gemini-2.5-flash-lite
# Optionaler Fallback (gleiches Enum). Wird bei Timeout/429/5xx automatisch genutzt.
# opencode nutzt automatisch https://opencode.ai/inference/openai/v1
# Vision-Modelle (Beispiele): mimo-v2.6-flash-free, nemotron-3.5-super-vl-free,
# glm-5.3-flash, mistral-large-4
VISION_FALLBACK_PROVIDER=
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_MODEL=
# Nur für openai_compatible nötig (z. B. lokales llama.cpp):
VISION_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Cloudflare Turnstile (optional) -----------------------------------------
# Sind beide Keys gesetzt, verlangt /receipts/scan ein gültiges Turnstile-Token.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
