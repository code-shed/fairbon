# Konfiguration fuer den Supermarkt-Preisvergleich
# Kopieren und anpassen:   cp .env.example .env   &&   nano .env
#
# Alle Einstellungen werden als Umgebungsvariablen gelesen. Kurze Namen
# (STEALTH_MODE, SITE_PASSWORD, SESSION_SECRET, ADMIN_PASSWORD, ...)
# funktionieren direkt; zusaetzlich akzeptiert die App die Form mit Praefix
# SUPERMARKET_<FELDNAME>. Ist beides gesetzt, gewinnt die Variante mit Praefix.

# --- Zugriffsschutz & Stealth ------------------------------------------------
# true  = noindex-Header, robots.txt "Disallow: /", noindex-Meta in der Seite.
# false = Seite darf von Suchmaschinen indexiert werden.
STEALTH_MODE=true

# Passwort-Gate fuer UI und API. Leer lassen = kein Passwortschutz.
# Login im Browser unter /login; API-Clients nutzen Basic Auth (Beliebig:Passwort).
SITE_PASSWORD=geheim123

# Zufaelliges, stabiles Cookie-Secret. Erzeugen mit:
#   openssl rand -base64 32
# Leer = wird aus SITE_PASSWORD abgeleitet.
SESSION_SECRET=

# --- Admin (Fail-Closed) ------------------------------------------------------
# Starkes Passwort fuer /admin, Backup/Restore und Moderations-Endpunkte.
# WICHTIG: Ohne gesetztes ADMIN_PASSWORD sind diese Endpunkte DEAKTIVIERT (503).
ADMIN_PASSWORD=

# --- CORS & Proxy -------------------------------------------------------------
# Kommaseparierte erlaubte Origins (Default: * fuer Entwicklung).
# PRODUKTION: explizite Liste setzen, z. B.
#   SUPERMARKET_CORS_ORIGINS=https://fairbon.example.org,capacitor://localhost
# Mit '*' werden keine Credentials/Cookies erlaubt (bewusste Haertung).
SUPERMARKET_CORS_ORIGINS=*

# Vertrauenswuerdiger Reverse Proxy? true = CF-Connecting-IP / X-Forwarded-For
# werden fuer Rate-Limiting ausgewertet (nur hinter Caddy/Nginx setzen!).
TRUST_PROXY=false

# --- Rate-Limiting & Kosten-Deckel (Phase 2: Foto-Scans) ----------------------
# MAX_SCANS_PER_DAY_PER_IP=15
# MAX_GLOBAL_SCANS_PER_DAY=500

# --- Datenbank & Limits ------------------------------------------------------
SUPERMARKET_DATABASE_PATH=./data/supermarkt.db
SUPERMARKET_MAX_RESULTS=1000

# --- kaufDA-Fallback ---------------------------------------------------------
# Zweitquelle fuer Angebote (Bonial).
# SUPERMARKET_KAUFDA_ENABLED=true
# SUPERMARKET_KAUFDA_LIMIT=50

# --- Vision-API (Phase 2: Kassenbon-Scanner) ---------------------------------
# VISION_PRIMARY_PROVIDER=gemini|mistral|openai_compatible
# VISION_PRIMARY_API_KEY=
# VISION_PRIMARY_MODEL=gemini-2.5-flash-lite
# VISION_FALLBACK_PROVIDER=
# VISION_FALLBACK_API_KEY=
# VISION_FALLBACK_MODEL=
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
