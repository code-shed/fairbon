# FairBon configuration
# Copy and edit:   cp .env.example .env   &&   chmod 600 .env
#
# Every setting is read from environment variables. Short names
# (STEALTH_MODE, SITE_PASSWORD, SESSION_SECRET, ADMIN_PASSWORD, ...) work
# directly; the SUPERMARKET_<FIELD> form is also accepted. If both are set,
# the prefixed variant wins.

# --- Access & stealth --------------------------------------------------------
# true  = noindex headers, robots.txt "Disallow: /", noindex meta tag.
# false = the site may be indexed by search engines.
STEALTH_MODE=true

# Hosted give-and-take mode (fairbon.org): share anonymous prices by
# default; self-hosters keep the opt-in. Own API keys (BYOK) opt out.
REQUIRE_COMMUNITY_SHARING=false

# Password gate for UI and API. Empty = no password protection.
# Browser login at /login; API clients use Basic Auth (any username, the password).
# PRODUCTION: set a strong password, e.g. `openssl rand -base64 24`.
# Never commit a real value here — keep this empty in the repository.
SITE_PASSWORD=

# Random, stable cookie secret. Generate with:
#   openssl rand -base64 32
# Empty = derived from SITE_PASSWORD (changes when the password changes).
SESSION_SECRET=

# --- Admin (fail-closed) -----------------------------------------------------
# Strong password for /admin, backup/restore and moderation endpoints.
# IMPORTANT: without ADMIN_PASSWORD these endpoints are DISABLED (503).
ADMIN_PASSWORD=

# --- CORS & proxy ------------------------------------------------------------
# Comma-separated allowed origins (default: * for development).
# PRODUCTION: set an explicit list, e.g.
#   SUPERMARKET_CORS_ORIGINS=https://fairbon.example.org,capacitor://localhost
# With '*' no credentials/cookies are allowed (deliberate hardening).
SUPERMARKET_CORS_ORIGINS=*

# Trusted reverse proxy? true = CF-Connecting-IP / X-Forwarded-For are used
# for rate limiting (only enable behind Caddy/Nginx!).
TRUST_PROXY=false

# --- Rate limiting & cost caps (photo scans) ---------------------------------
MAX_SCANS_PER_DAY_PER_IP=15
MAX_GLOBAL_SCANS_PER_DAY=500

# --- Upload hardening --------------------------------------------------------
# Hard cap for images/PDFs (default: 3 MB).
MAX_UPLOAD_BYTES=3145728

# --- Database & limits -------------------------------------------------------
# Docker sets the path to /app/data/supermarkt.db (see docker-compose.yml).
SUPERMARKET_DATABASE_PATH=./data/supermarkt.db
SUPERMARKET_MAX_RESULTS=1000
# Set inside the container; override only for a different static path:
# SUPERMARKET_FRONTEND_DIR=/app/frontend

# --- Vision API (receipt scanner) -------------------------------------------
# Primary provider: gemini | mistral | openai_compatible | opencode
VISION_PRIMARY_PROVIDER=
VISION_PRIMARY_API_KEY=
VISION_PRIMARY_MODEL=gemini-2.5-flash-lite
# Optional fallback (same enum). Used automatically on timeout/429/5xx.
# opencode = OpenCode Go (subscription): https://opencode.ai/inference/go/openai/v1
# opencode_zen = OpenCode Zen/Console (pay-as-you-go): .../inference/openai/v1
# Vision-capable Go models (examples): glm-5.3-flash, deepseek-v4.1-flash,
# mimo-v2.6-flash, minimax-m3.1-flash, hy4-flash-free
VISION_FALLBACK_PROVIDER=
VISION_FALLBACK_API_KEY=
VISION_FALLBACK_MODEL=
# Only needed for openai_compatible (e.g. local llama.cpp):
VISION_OPENAI_BASE_URL=https://api.openai.com/v1

# --- Legal pages (/impressum, /datenschutz) ---------------------------------
# Leave empty for private test/self-hosted instances: the pages then show a
# neutral placeholder. Fill these ONLY on the public server - never commit
# real names, addresses or contact details to this repository.
# Address lines can be separated with " | " or a literal newline.
IMPRINT_NAME=""
IMPRINT_CO=""
IMPRINT_ADDRESS=""
IMPRINT_EMAIL=""
IMPRINT_PHONE=""
PRIVACY_HOSTER=""
# Empty -> derived from VISION_PRIMARY_PROVIDER / VISION_FALLBACK_PROVIDER.
PRIVACY_VISION_PROVIDER=""
# Empty -> falls back to IMPRINT_EMAIL.
PRIVACY_CONTACT_EMAIL=""
# Retention of technical server/access logs.
PRIVACY_LOG_RETENTION="in der Regel bis zu 7 Tage"
# Provider name, country / third-country transfer and retention according to
# the API terms, e.g. "Mistral AI SAS (Frankreich/EU), Verarbeitung gemäß
# API-Bedingungen ohne dauerhafte Speicherung für Modelltraining".
PRIVACY_VISION_PROVIDER_DETAILS=""
# Competent supervisory authority at the operator's seat (optional).
PRIVACY_SUPERVISORY_AUTHORITY=""

# WICHTIG: Vor einem öffentlichen Betrieb MÜSSEN hier echte Betreiber- und
# Kontaktdaten (IMPRINT_*) sowie die konkreten Dienstleister-Angaben
# (PRIVACY_HOSTER, PRIVACY_VISION_PROVIDER_DETAILS, ggf. Aufsichtsbehörde)
# eingetragen werden. Niemals echte Daten in dieses Repository committen.

# --- Cloudflare Turnstile (optional) ----------------------------------------
# If both keys are set, /receipts/scan requires a valid Turnstile token.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
