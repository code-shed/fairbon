# === FairBon .gitignore ===
# Secrets & Konfiguration
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
config/local.*

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.tox/
.venv/
venv/
env/
pip-wheel-metadata/
*.egg-info/
dist/
build/
.eggs/

# Node / Frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.next/
.out/
.turbo/
*.tsbuildinfo

# Datenbanken & Dumps (nur echte Daten, keine Schema-Beispiele)
*.db
*.sqlite
*.sqlite3
*.db-journal
*.dump
*.sql.gz
data/
!data/schema.sql
!data/*.example.sql

# IDE / Editor
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.log

# OS / Temporär
*.tmp
*.temp
.cache/
*.bak
*.orig

# Test-Artifacts
coverage/
.nyc_output/
playwright-report/
test-results/

# Docker
.docker/
docker-compose.override.yml

# CI / Build
*.tar.gz
*.whl